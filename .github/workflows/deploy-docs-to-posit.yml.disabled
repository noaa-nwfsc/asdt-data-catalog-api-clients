name: Deploy SDK Docs to Posit Connect

on:
  push:
    branches:
      - develop
      - main
      - "docs/**"
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # ============================================================================
  # JOB 1: DEV Deployment (Runs on 'develop' branch -> TEST Posit Server)
  # ============================================================================
  deploy-dev:
    if: github.ref == 'refs/heads/develop' || startsWith(github.ref, 'refs/heads/docs/')
    runs-on: self-hosted

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up uv
        uses: astral-sh/setup-uv@v3

      - name: Install R Build Tools
        run: |
          # Create a local directory for R packages inside the workspace
          mkdir -p ${{ github.workspace }}/.Rlibs

          # Tell GitHub Actions to use this directory for all future steps
          echo "R_LIBS_USER=${{ github.workspace }}/.Rlibs" >> $GITHUB_ENV
          export R_LIBS_USER=${{ github.workspace }}/.Rlibs

          # Install the packages into this specific local directory
          Rscript -e "install.packages(c('roxygen2', 'pkgdown'), lib='${{ github.workspace }}/.Rlibs', repos='https://cloud.r-project.org')"

      - name: Install Posit Connect CLI
        run: pip install rsconnect-python

      - name: Generate API Clients
        run: make build-all

      - name: Bootstrap Python Client Virtual Environment
        run: |
          cd clients/python_public
          uv sync
          uv pip install sphinx pydata-sphinx-theme
          cd ../..

      - name: Run documentation builds
        run: |
          make docs-python
          make docs-r

      - name: Prepare Unified Site Directory
        run: |
          mkdir -p _site
          mv docs/python _site/python
          mv clients/r_public/docs _site/r
          cp docs/index.html _site/index.html
          cp docs/data_rockfish_banner.png _site/data_rockfish_banner.png

      - name: Generate Redoc API Page
        run: |
          mkdir -p _site/api
          cp openapi/openapi-public.json _site/api/openapi.json
          cat <<EOF > _site/api/index.html
          <!DOCTYPE html>
          <html>
            <head>
              <title>NWFSC Groundfish Data Catalog API Docs</title>
              <meta charset="utf-8"/>
              <meta name="viewport" content="width=device-width, initial-scale=1">
              <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,700|Roboto:300,400,700" rel="stylesheet">
              <style>body { margin: 0; padding: 0; }</style>
            </head>
            <body>
              <redoc spec-url='openapi.json'></redoc>
              <script src="https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js"> </script>
            </body>
          </html>
          EOF

      - name: Deploy DEV Docs (TEST Posit Server)
        env:
          POSIT_CONNECT_TEST_SERVER_API_KEY: ${{ secrets.POSIT_CONNECT_TEST_SERVER_API_KEY }}
          POSIT_CONNECT_DOCS_ID_DEV: ${{ vars.POSIT_CONNECT_DOCS_ID_DEV }}
        run: |
          rsconnect add --server https://test-connect.fisheries.noaa.gov/ --name noaa-connect-test --api-key $POSIT_CONNECT_TEST_SERVER_API_KEY || true
          rsconnect deploy html _site \
            --name noaa-connect-test \
            --title "NWFSC Groundfish Data Catalog SDK Docs (DEV)" \
            $(if [ -n "$POSIT_CONNECT_DOCS_ID_DEV" ]; then echo "--app-id $POSIT_CONNECT_DOCS_ID_DEV"; fi)

  # ============================================================================
  # JOB 2: PROD Deployment (Runs on 'main' branch -> PROD Posit Server)
  # ============================================================================
  deploy-prod:
    if: github.ref == 'refs/heads/main'
    runs-on: self-hosted

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up uv
        uses: astral-sh/setup-uv@v3

      - name: Install R Build Tools
        run: |
          # Create a local directory for R packages inside the workspace
          mkdir -p ${{ github.workspace }}/.Rlibs

          # Tell GitHub Actions to use this directory for all future steps
          echo "R_LIBS_USER=${{ github.workspace }}/.Rlibs" >> $GITHUB_ENV
          export R_LIBS_USER=${{ github.workspace }}/.Rlibs

          # Install the packages into this specific local directory
          Rscript -e "install.packages(c('roxygen2', 'pkgdown'), lib='${{ github.workspace }}/.Rlibs', repos='https://cloud.r-project.org')"

      - name: Install Posit Connect CLI
        run: pip install rsconnect-python

      - name: Generate API Clients
        run: make build-all

      - name: Bootstrap Python Client Virtual Environment
        run: |
          cd clients/python_public
          uv sync
          uv pip install sphinx pydata-sphinx-theme
          cd ../..

      - name: Run documentation builds
        run: |
          make docs-python
          make docs-r

      - name: Prepare Unified Site Directory
        run: |
          mkdir -p _site
          mv docs/python _site/python
          mv clients/r_public/docs _site/r
          cp docs/index.html _site/index.html
          cp docs/data_rockfish_banner.png _site/data_rockfish_banner.png

      - name: Generate Redoc API Page
        run: |
          mkdir -p _site/api
          cp openapi/openapi-public.json _site/api/openapi.json
          cat <<EOF > _site/api/index.html
          <!DOCTYPE html>
          <html>
            <head>
              <title>NWFSC Groundfish Data Catalog API Docs</title>
              <meta charset="utf-8"/>
              <meta name="viewport" content="width=device-width, initial-scale=1">
              <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,700|Roboto:300,400,700" rel="stylesheet">
              <style>body { margin: 0; padding: 0; }</style>
            </head>
            <body>
              <redoc spec-url='openapi.json'></redoc>
              <script src="https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js"> </script>
            </body>
          </html>
          EOF

      - name: Deploy PROD Docs (PROD Posit Server)
        env:
          POSIT_CONNECT_PROD_SERVER_API_KEY: ${{ secrets.POSIT_CONNECT_PROD_SERVER_API_KEY }}
          POSIT_CONNECT_DOCS_ID_PROD: ${{ vars.POSIT_CONNECT_DOCS_ID_PROD }}
        run: |
          rsconnect add --server https://connect.fisheries.noaa.gov/ --name noaa-connect-prod --api-key $POSIT_CONNECT_PROD_SERVER_API_KEY || true
          rsconnect deploy html _site \
            --name noaa-connect-prod \
            --title "NWFSC Groundfish Data Catalog SDK Docs" \
            $(if [ -n "$POSIT_CONNECT_DOCS_ID_PROD" ]; then echo "--app-id $POSIT_CONNECT_DOCS_ID_PROD"; fi)
